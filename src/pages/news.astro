---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "../lib/sanity";

import "../styles/news-page.css";

const categoryLabels: Record<string, string> = {
  course: "課程資訊",
  event: "活動消息",
  announcement: "計畫公告",
};

const newsItems = await sanityClient.fetch(`
  *[
    _type == "news" &&
    visible == true
  ]
  | order(pinned desc, date desc)
  {
    _id,
    title,
    date,
    category,
    content,
    link,
    pinned
  }
`);

function displayDate(date: string) {
  return date?.replaceAll("-", ".");
}
---

<BaseLayout title="最新消息｜AI × 照護">

  <section class="news-page">

    <div class="news-page-container">

      <header class="news-page-heading">

        <p class="news-page-eyebrow">
          LATEST NEWS
        </p>

        <h1>
          最新消息
        </h1>

      </header>


      <div class="news-page-list">

        {
          newsItems.map((item: any) => (

            <article class="news-page-item">

              <div class="news-page-meta">
          
                <time datetime={item.date}>
                  {displayDate(item.date)}
                </time>

                <span>
                  {categoryLabels[item.category] ?? item.category}
                </span>

              </div>

              <div class="news-page-content">

                <h2>
                  {item.title}
                </h2>

                {
                  item.content && (
                    <p class="news-page-description">
                      {item.content}
                    </p>
                  )
                }


                {
                  item.link && (

                    <a
                      class="news-page-link"
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      查看連結
                    </a>

                  )
                }

              </div>

            </article>

          ))
        }

      </div>

    </div>

  </section>

</BaseLayout>