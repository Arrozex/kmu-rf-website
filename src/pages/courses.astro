---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseCard from "../components/CourseCard.astro";

import { sanityClient } from "../lib/sanity";

import "../styles/courses.css";


const rawCourses = await sanityClient.fetch(`
  *[
    _type == "course" &&
    visible == true
  ]
  | order(sortDate asc)
  {
    _id,
    title,
    "slug": slug.current,

    status,
    registrationMode,
    level,
    unit,

    instructors,
    description,
    delivery,

    dateText,
    sortDate,
    time,
    location,

    registrationType,
    registrationUrl,
    pretestUrl,
    detailUrl,
    notice
  }
`);


const statusLabels: Record<string, string> = {
  enrolling: "報名開放",
  closed: "停止報名",
};


const registrationLabels: Record<string, string> = {
  wac: "WAC 選課",
  online: "線上報名",
};


const levelLabels: Record<string, string> = {
  professional: "專業領域",
  basic: "AI 基礎",
  advanced: "AI 應用",
  practical: "AI 技術實務",
};


const unitLabels: Record<string, string> = {
  nursing: "護理學系",
  baia: "人工智慧生醫研究院",
  hami: "醫務管理暨醫療資訊學系",
  occupational: "職能治療學系",
  physical: "物理治療學系",
  taica: "TAICA",
};


const courses = rawCourses.map((course: any) => ({
  id: course.slug,

  status: course.status,
  statusLabel:
    statusLabels[course.status] ?? course.status,

  title: course.title,

  registrationMode:
    course.registrationMode,

  registrationModeLabel:
    registrationLabels[course.registrationMode]
      ?? course.registrationMode,

  level: course.level,

  levelLabel:
    levelLabels[course.level]
      ?? course.level,

  unit: course.unit,

  unitLabel:
    unitLabels[course.unit]
      ?? course.unit,

  instructors:
    course.instructors ?? "",

  description:
    course.description ?? "",

  delivery:
    course.delivery ?? "",

  date:
    course.dateText ?? "",

  time:
    course.time ?? "",

  location:
    course.location ?? "",

  href:
    `/registration?course=${encodeURIComponent(course.slug)}`,
}));
---

<BaseLayout title="近期課程｜AI × 照護">

  <section class="courses-page">

    <div class="courses-page-container">

      <header class="courses-page-heading">

        <p class="courses-page-eyebrow">
          COURSES
        </p>

        <h1>
          探索課程
        </h1>

        <p>
          從護理專業、AI 基礎到進階實作，
          依照自己的學習需求探索目前開放的課程與活動。
        </p>

      </header>


      <!-- Filters -->

      <section
        class="course-filters"
        aria-label="課程篩選"
      >

        <label class="filter-field">
          <span>報名狀態</span>

          <select data-filter="status">
            <option value="all">全部狀態</option>
            <option value="enrolling">報名開放</option>
            <option value="closed">停止報名</option>
          </select>
        </label>


        <label class="filter-field">
          <span>選課方式</span>

          <select data-filter="registration">
            <option value="all">全部方式</option>
            <option value="wac">WAC 選課</option>
            <option value="online">線上報名</option>
          </select>
        </label>


        <label class="filter-field">
          <span>課程類別</span>

          <select data-filter="level">
            <option value="all">全部類別</option>
            <option value="professional">專業領域</option>
            <option value="basic">AI 基礎</option>
            <option value="advanced">AI 應用</option>
            <option value="practical">AI 技術實務</option>
          </select>
        </label>


        <label class="filter-field">
          <span>開課單位</span>

          <select data-filter="unit">
            <option value="all">全部單位</option>
            <option value="nursing">護理學系</option>
            <option value="baia">人工智慧生醫研究院</option>
            <option value="hami">醫務管理暨醫療資訊學系</option>
            <option value="occupational">職能治療學系</option>
            <option value="physical">物理治療學系</option>
            <option value="taica">TAICA</option>
          </select>
        </label>

      </section>


      <div class="courses-result-bar">

        <p>
          顯示
          <strong data-result-count>
            {courses.length}
          </strong>
          門課程
        </p>

        <button
          class="filter-reset"
          type="button"
          data-filter-reset
        >
          清除篩選
        </button>

      </div>


      <div class="courses-grid">

        {
          courses.map((course: any) => (
            <CourseCard course={course} />
          ))
        }

      </div>


      <div
        class="no-results"
        data-no-results
        hidden
      >
        <p>
          沒有符合目前條件的課程。
        </p>

        <button
          type="button"
          data-filter-reset
        >
          清除篩選
        </button>
      </div>

    </div>

  </section>


  <script>

    const selects =
      document.querySelectorAll<HTMLSelectElement>(
        "[data-filter]"
      );

    const cards =
      document.querySelectorAll<HTMLElement>(
        "[data-course-card]"
      );

    const resultCount =
      document.querySelector<HTMLElement>(
        "[data-result-count]"
      );

    const noResults =
      document.querySelector<HTMLElement>(
        "[data-no-results]"
      );

    const resetButtons =
      document.querySelectorAll<HTMLButtonElement>(
        "[data-filter-reset]"
      );


    function filterCourses() {

      const filters: Record<string, string> = {};


      selects.forEach((select) => {

        const key =
          select.dataset.filter;

        if (key) {
          filters[key] = select.value;
        }

      });


      let visibleCount = 0;


      cards.forEach((card) => {

        const matches =
          Object.entries(filters)
            .every(([key, value]) => {

              if (value === "all") {
                return true;
              }

              return (
                card.dataset[key] === value
              );

            });


        card.hidden = !matches;


        if (matches) {
          visibleCount++;
        }

      });


      if (resultCount) {
        resultCount.textContent =
          String(visibleCount);
      }


      if (noResults) {
        noResults.hidden =
          visibleCount !== 0;
      }

    }


    selects.forEach((select) => {

      select.addEventListener(
        "change",
        filterCourses
      );

    });


    resetButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          selects.forEach(
            select =>
              select.value = "all"
          );

          filterCourses();

        }
      );

    });

  </script>

</BaseLayout>