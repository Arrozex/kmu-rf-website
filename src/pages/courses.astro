---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseCard from "../components/CourseCard.astro";

import { courses } from "../data/courses";

import "../styles/courses.css";
---

<BaseLayout
  title="近期課程｜AI × 護理"
>

  <section class="courses-page">

    <div class="courses-page-container">

      <!-- =======================
           Page Heading
      ======================== -->

      <header class="courses-page-heading">

        <p class="courses-page-eyebrow">
          COURSES
        </p>

        <h1>
          近期課程
        </h1>

      </header>


      <!-- =======================
           Filters
      ======================== -->

      <section
        class="course-filters"
        aria-label="課程篩選"
      >

        <!-- 1 Status -->

        <label class="filter-field">

          <span>
            報名狀態
          </span>

          <select data-filter="status">
            <option value="all">
              全部狀態
            </option>

            <option value="enrolling">
              報名中
            </option>

            <option value="ongoing">
              開課中
            </option>

            <option value="closed">
              停止報名
            </option>
          </select>

        </label>


        <!-- 2 Registration -->

        <label class="filter-field">

          <span>
            選課方式
          </span>

          <select data-filter="registration">
            <option value="all">
              全部方式
            </option>

            <option value="wac">
              WAC 選課
            </option>

            <option value="online">
              線上報名
            </option>
          </select>

        </label>


        <!-- 3 Level -->

        <label class="filter-field">

          <span>
            課程類別
          </span>

          <select data-filter="level">
            <option value="all">
              全部類別
            </option>

            <option value="professional">
              專業領域
            </option>

            <option value="basic">
              AI 基礎
            </option>

            <option value="advanced">
              AI 進階
            </option>
          </select>

        </label>


        <!-- 4 Unit -->

        <label class="filter-field">

          <span>
            開課單位
          </span>

          <select data-filter="unit">
            <option value="all">
              全部單位
            </option>

            <option value="nursing">
              護理學系
            </option>

            <option value="baia">
              人工智慧生醫研究院
            </option>

            <option value="hami">
              醫務管理暨醫療資訊學系
            </option>

            <option value="cfs">
              基礎科學教育中心
            </option>
          </select>

        </label>

      </section>


      <!-- 顯示筆數 -->

      <div class="courses-result-bar">

        <p>
          顯示
          <strong data-result-count>
            {courses.length}
          </strong>
          門課程
        </p>

        <button
          class="filter-reset"
          type="button"
          data-filter-reset
        >
          清除篩選
        </button>

      </div>


      <!-- =======================
           Course Cards
      ======================== -->

      <div class="courses-grid">

        {
          courses.map((course) => (
            <CourseCard course={course} />
          ))
        }

      </div>

      <section class="course-calendar" id="calendar">

        <div class="course-calendar-heading">

            <div>
            <p class="course-calendar-eyebrow">
                COURSE CALENDAR
            </p>

            <h2>
                課程行事曆
            </h2>
            </div>

        </div>


        <div class="calendar-frame">

            <iframe
            src="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=Asia%2FTaipei&showPrint=0&src=YmFpYXJhaW5mb3Jlc3QyMDI1MjZAZ21haWwuY29t&src=MjcwMjIzYmExODk4MzIwYzExMjdjOTJlOTNhYjgxZWM4MTUwYmNjYjNhM2E1ZTgzYWU2Zjc5NTBmODc0NGI2M0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23039be5&color=%23e4c441"
            title="AI × 護理課程行事曆"
            loading="lazy"
            frameborder="0"
            scrolling="no"
            >
            </iframe>

        </div>

    　</section>


      <!-- 無結果 -->

      <div
        class="no-results"
        data-no-results
        hidden
      >
        <p>
          沒有符合目前條件的課程。
        </p>

        <button
          type="button"
          data-filter-reset
        >
          清除篩選
        </button>
      </div>

    </div>

  </section>


  <!-- Filters JS -->

  <script>

    const selects =
      document.querySelectorAll<HTMLSelectElement>(
        "[data-filter]"
      );

    const cards =
      document.querySelectorAll<HTMLElement>(
        "[data-course-card]"
      );

    const resultCount =
      document.querySelector<HTMLElement>(
        "[data-result-count]"
      );

    const noResults =
      document.querySelector<HTMLElement>(
        "[data-no-results]"
      );

    const resetButtons =
      document.querySelectorAll<HTMLButtonElement>(
        "[data-filter-reset]"
      );


    function filterCourses() {

      const filters: Record<string, string> = {};


      selects.forEach((select) => {

        const key =
          select.dataset.filter;

        if (key) {
          filters[key] =
            select.value;
        }

      });


      let visibleCount = 0;


      cards.forEach((card) => {

        const matches =
          Object.entries(filters)
            .every(([key, value]) => {

              if (value === "all") {
                return true;
              }

              return (
                card.dataset[key] === value
              );

            });


        card.hidden = !matches;


        if (matches) {
          visibleCount++;
        }

      });


      if (resultCount) {
        resultCount.textContent =
          String(visibleCount);
      }


      if (noResults) {
        noResults.hidden =
          visibleCount !== 0;
      }

    }


    selects.forEach((select) => {

      select.addEventListener(
        "change",
        filterCourses
      );

    });


    resetButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          selects.forEach((select) => {
            select.value = "all";
          });

          filterCourses();

        }
      );

    });

  </script>

</BaseLayout>