---
import "../styles/news.css";
---

<section class="news-section" id="news">
  <div class="news-container">

    <!-- 區塊標題 -->
    <div class="news-header">
      <div>
        <p class="news-eyebrow">
          LATEST NEWS
        </p>

        <h2 class="news-title">
          最新消息
        </h2>
      </div>

      <a class="news-view-all" href="/news">
        查看全部
        <span aria-hidden="true">↗</span>
      </a>
    </div>


    <!-- 消息列表 -->
    <div class="news-list">

      <article class="news-item">
        <div class="news-meta">
          <time datetime="2026-08-01">
            2026.08.01
          </time>

          <span class="news-category">
            課程資訊
          </span>
        </div>

        <h3 class="news-item-title">
          <a href="/registration">
            2026 秋季課程即將開放報名
          </a>
        </h3>
      </article>


      <article class="news-item">
        <div class="news-meta">
          <time datetime="2026-07-20">
            2026.07.20
          </time>

          <span class="news-category">
            活動消息
          </span>
        </div>

        <h3 class="news-item-title">
          <a href="/presentation">
            AI × VR 工作坊課程成果更新
          </a>
        </h3>
      </article>


      <article class="news-item">
        <div class="news-meta">
          <time datetime="2026-07-10">
            2026.07.10
          </time>

          <span class="news-category">
            計畫公告
          </span>
        </div>

        <h3 class="news-item-title">
          <a href="#courses">
            新學期課程行事曆更新
          </a>
        </h3>
      </article>

    </div>

  </div>
</section>