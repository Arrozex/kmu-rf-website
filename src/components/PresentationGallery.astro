---
import { sanityClient } from "../lib/sanity";
import "../styles/presentation.css";

const events = await sanityClient.fetch(`
  *[
    _type == "result" &&
    visible == true
  ]
  | order(featured desc, eventDate desc)
  {
    _id,
    title,
    "id": slug.current,
    eventDate,
    category,
    description,

    "coverImage": coverImage.asset->url,

    "images": gallery[]{
      "src": asset->url,
      alt,
      caption
    }
  }
`);

const firstEvent = events[0];

const categoryLabels: Record<string, string> = {
  course: "課程",
  workshop: "工作坊",
  event: "活動",
};
---

{
  firstEvent ? (

    <div class="presentation-layout">

      <!-- 你原本的左側 -->

      <aside class="presentation-sidebar">

        <div class="presentation-sidebar-inner">

          <p class="presentation-eyebrow">
            COURSE HIGHLIGHTS
          </p>

          <h1 class="presentation-title">
            活動回顧
          </h1>


          <div class="presentation-current">

            <p
              class="presentation-current-date"
              data-current-date
            >
              {firstEvent.eventDate}
            </p>

            <h2 data-current-title>
              {firstEvent.title}
            </h2>

            <p
              class="presentation-current-description"
              data-current-description
            >
              {firstEvent.description}
            </p>

          </div>


          <div class="event-selector">

            {
              events.map((event: any, index: number) => (

                <button
                  class:list={[
                    "event-selector-button",
                    {
                      "is-active": index === 0
                    }
                  ]}
                  type="button"
                  data-event-button={event.id}
                >

                  <span class="event-selector-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="event-selector-text">

                    <span>
                      {event.title}
                    </span>

                    <small>
                      {event.eventDate}

                      {
                        event.category &&
                        ` · ${categoryLabels[event.category]}`
                      }
                    </small>

                  </span>

                </button>

              ))
            }

          </div>

        </div>

      </aside>


      <!-- 右邊照片 -->

      <div
        class="presentation-gallery"
        data-gallery
      >

        {
          firstEvent.images?.map(
            (image: any, index: number) => (

              <article
                class="presentation-photo-card"
                style={`--card-index: ${index};`}
              >

                <figure>

                  <img
                    src={image.src}
                    alt={image.alt || firstEvent.title}
                    loading={index === 0 ? "eager" : "lazy"}
                  />

                  <figcaption>

                    <span>
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <p>
                      {image.caption || ""}
                    </p>

                  </figcaption>

                </figure>

              </article>

            )
          )
        }

      </div>

    </div>

  ) : (

    <div class="presentation-empty">
      <p>目前尚無成果資料。</p>
    </div>

  )
}

<script
  define:vars={{
    eventData: events
  }}
>

  const buttons =
    document.querySelectorAll(
      "[data-event-button]"
    );

  const gallery =
    document.querySelector(
      "[data-gallery]"
    );

  const title =
    document.querySelector(
      "[data-current-title]"
    );

  const date =
    document.querySelector(
      "[data-current-date]"
    );

  const description =
    document.querySelector(
      "[data-current-description]"
    );


  function renderEvent(eventId) {

    const event =
      eventData.find(
        item =>
          item.id === eventId
      );


    if (!event || !gallery) {
      return;
    }


    if (title) {
      title.textContent =
        event.title;
    }


    if (date) {
      date.textContent =
        event.eventDate;
    }


    if (description) {
      description.textContent =
        event.description || "";
    }


    gallery.innerHTML =
      (event.images || [])
        .map(
          (image, index) => `
            <article
              class="presentation-photo-card"
              style="--card-index: ${index};"
            >
              <figure>

                <img
                  src="${image.src}"
                  alt="${image.alt || event.title}"
                  loading="lazy"
                />

                <figcaption>

                  <span>
                    ${String(index + 1)
                      .padStart(2, "0")}
                  </span>

                  <p>
                    ${image.caption || ""}
                  </p>

                </figcaption>

              </figure>
            </article>
          `
        )
        .join("");


    buttons.forEach(button => {

      button.classList.toggle(
        "is-active",
        button.dataset.eventButton === eventId
      );

    });


    const top =
      gallery.getBoundingClientRect().top +
      window.scrollY -
      110;


    window.scrollTo({
      top,
      behavior: "smooth"
    });

  }


  buttons.forEach(button => {

    button.addEventListener(
      "click",
      () => {

        const eventId =
          button.dataset.eventButton;

        if (eventId) {
          renderEvent(eventId);
        }

      }
    );

  });

</script>