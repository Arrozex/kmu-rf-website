---
import "../styles/hero.css";
---

<section class="hero" id="about">
  <div class="hero-content">
    <p class="hero-eyebrow">
      WELCOME TO AI × NURSING
    </p>

    <h1 class="hero-title">
      讓醫護專業
      <span>與AI未來結合</span>
    </h1>

    <p class="hero-description">
      從人工智慧基礎、程式設計到臨床實務應用，
      培養醫護與科技的跨領域整合能力。
    </p>

    <div class="hero-actions">
      <a class="hero-button hero-button-primary" href="/courses">
        查看近期課程
      </a>

      <a class="hero-button hero-button-secondary" href="/registration">
        立即報名
        <span aria-hidden="true">↗</span>
      </a>

      <a class="hero-button hero-button-secondary" href="https://lin.ee/REqoALUQ">
        LINE官方帳號聯絡我們
        <span aria-hidden="true">↗</span>
      </a>

    </div>
  </div>

  <div class="hero-image-wrapper">
    <img
      class="hero-image"
      src="/images/hero-placeholder.png"
      alt="智慧照護創新計劃LOGO"
    />
  </div>
</section>