---
import "../styles/curriculum-map.css";
---

<section class="curriculum-section" id="curriculum">

  <div class="curriculum-container">

    <!-- Section 標題 -->
    <div class="curriculum-heading">
      <p class="curriculum-eyebrow">
        CURRICULUM MAP
      </p>

      <h2 class="curriculum-title">
        從理解 AI，<br />
        走向臨床實作。
      </h2>
    </div>


    <!-- 左圖右文 -->
    <div class="curriculum-layout">

      <!-- 左側圖片 -->
      <figure class="curriculum-image-wrapper">
        <img
          class="curriculum-image"
          src="/images/curriculum-map.png"
          alt="護理創新與人工智慧應用人才培育計畫課程地圖"
        />
      </figure>


      <!-- 右側單一說明框 -->
      <div class="curriculum-content">

        <div class="curriculum-introduction">

          <p class="curriculum-small-title">
            TWO YEARS · FOUR SEMESTERS
          </p>

          <h3>
            四個課群，逐步建立
            護理 × AI 的跨域能力。
          </h3>

          <p>
            本學程規劃為兩年、共四學期，
            以「專業領域」與「AI 素養」為主要學習軸線，
            從基礎概念、技術進階到臨床實作與成果產出，
            建立完整的跨領域學習路徑。
          </p>

        </div>


        <!-- 四個課群 -->
        <div class="curriculum-list">

          <div class="curriculum-item">
            <span class="curriculum-number">
              01
            </span>

            <div>
              <h4>護理創新專業</h4>

              <p>
                從護理專業與臨床需求出發，
                建立科技與照護應用之間的連結。
              </p>
            </div>
          </div>


          <div class="curriculum-item">
            <span class="curriculum-number">
              02
            </span>

            <div>
              <h4>AI 概念</h4>

              <p>
                認識人工智慧、VR／AR 與程式設計，
                建立 Python 與 AI 的基礎知識。
              </p>
            </div>
          </div>


          <div class="curriculum-item">
            <span class="curriculum-number">
              03
            </span>

            <div>
              <h4>AI 進階</h4>

              <p>
                延伸至機器學習、影像處理、
                VR 模擬與對話式 AI 等技術應用。
              </p>
            </div>
          </div>


          <div class="curriculum-item">
            <span class="curriculum-number">
              04
            </span>

            <div>
              <h4>AI 技術實務</h4>

              <p>
                結合臨床與產業導師，
                以實際需求完成跨域專題與成果展示。
              </p>
            </div>
          </div>

        </div>


        <a
          class="curriculum-link"
          href="/registration"
        >
          查看目前開放課程
          <span aria-hidden="true">↗</span>
        </a>

      </div>

    </div>

  </div>

</section>