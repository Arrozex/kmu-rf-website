---
import "../styles/header.css";
---

<header class="site-header">
  <div class="header-container">
    <a class="site-brand" href="/">
      <img
        class="site-logo"
        src="/images/logo01.png"
        alt="高雄醫學大學"
      />

      <div class="brand-text">
        <span class="brand-en">Healthcare Innovation and Artificial Intelligence <br> Application Talent Development Program</span>
        <span class="brand-zh">
          教育部「智慧雨林產業創生人才育成計畫」｜醫療照護創新與人工智慧應用人才培育計畫
        </span>
      </div>
    </a>

    <div class="header-actions">

      <nav class="main-navigation" aria-label="主要導覽">
        <a href="/">
          首頁
        </a>

        <div class="nav-dropdown">
          <a class="dropdown-trigger" href="/about">
            關於計畫
            <span class="dropdown-arrow" aria-hidden="true">▼</span>
          </a>

          <div class="dropdown-menu">
            <a href="/about#origin">計畫緣起</a>
            <a href="/about#targets">對象資格</a>
            <a href="/about#gain">職涯價值</a>
            <a href="/about#arrangement">計畫時程</a>
          </div>
        </div>

        <a href="/news">
          最新消息
        </a>

        <div class="nav-dropdown">
          <a class="dropdown-trigger">
            課程專區
            <span class="dropdown-arrow" aria-hidden="true">▼</span>
          </a>

          <div class="dropdown-menu">
            <a href="/courses">近期課程</a>
            <a href="/course">課程特色</a>
            <a href="/course#course-map-title">課程地圖</a>
            <a href="/course#join">參與方式</a>
            <a href="/#faq">常見問題</a>
          </div>
        </div>

        <a href="/presentation">
          成果回顧
        </a>
      </nav>

      <a class="register-button" href="/registration">
        課程報名
      </a>

    </div>

  </div>
</header>