---
import "../styles/header.css";
---

<header class="site-header">
  <div class="header-container">
    <a class="site-brand" href="/">
      <img
        class="site-logo"
        src="/images/logo01.png"
        alt="高雄醫學大學"
      />

      <div class="brand-text">
        <span class="brand-en">Healthcare Innovation and Artificial Intelligence <br> Application Talent Development Program</span>
        <span class="brand-zh">
          智慧照護創新與人工智慧人才培育計畫
        </span>
      </div>
    </a>

    <div class="header-actions">

      <nav class="main-navigation" aria-label="主要導覽">

        <div class="nav-dropdown">
          <a class="dropdown-trigger" href="/#about">
            計畫介紹
            <span class="dropdown-arrow" aria-hidden="true">▼</span>
          </a>

          <div class="dropdown-menu">
            <a href="/#news">最新消息</a>
            <a href="/#features">課程特色</a>
            <a href="/#curriculum">課程地圖</a>
            <a href="/#partners">合作單位</a>
            <a href="/#faq">常見問題</a>
          </div>
        </div>

        <a href="/courses">
          近期課程
        </a>

        <a href="/presentation">
          成果回顧
        </a>
      </nav>

      <a class="register-button" href="/registration">
        課程報名
      </a>

    </div>

  </div>
</header>